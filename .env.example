# Copy to .env and adjust. Every variable is optional: with no LLM keys the app
# runs in demo mode using the deterministic mock provider.

LOG_LEVEL=info
DATABASE_URL=postgres://lifeos:lifeos@localhost:5432/lifeos
REDIS_URL=redis://localhost:6379

# auto = Anthropic if ANTHROPIC_API_KEY is set, else OpenAI, else Ollama if reachable, else mock.
LLM_PROVIDER=auto
EMBEDDING_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SMART=claude-opus-5-5
# Fast tier (quick capture) runs at low effort. Set claude-haiku-5-5 here for cheaper capture.
ANTHROPIC_MODEL_FAST=claude-opus-5-5
OPENAI_API_KEY=
# Set these to OpenAI models available to your account.
OPENAI_MODEL_SMART=
OPENAI_MODEL_FAST=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LLM_DAILY_TOKEN_BUDGET=500000

# API
PORT=3000
WEB_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Worker
SMTP_URL=smtp://localhost:1025
APP_URL=http://localhost:5173

# Telemetry (start with: docker compose --profile observability up -d)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
