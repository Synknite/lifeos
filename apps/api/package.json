{
  "name": "@lifeos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --import ./src/instrumentation.ts src/main.ts",
    "build": "tsup",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@lifeos/config": "workspace:*",
    "@lifeos/core": "workspace:*",
    "@lifeos/db": "workspace:*",
    "@lifeos/domain": "workspace:*",
    "@lifeos/llm": "workspace:*",
    "@lifeos/observability": "workspace:*",
    "bullmq": "^5.81.5",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0"
  }
}
