{
  "name": "@lifeos/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --import ./src/instrumentation.ts src/main.ts",
    "build": "tsup",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@lifeos/config": "workspace:*",
    "@lifeos/core": "workspace:*",
    "@lifeos/db": "workspace:*",
    "@lifeos/llm": "workspace:*",
    "@lifeos/observability": "workspace:*",
    "bullmq": "^5.81.5",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.4",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0"
  }
}
